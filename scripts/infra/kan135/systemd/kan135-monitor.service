[Unit]
Description=KAN135 redacted delay and failure Telegram monitor
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/clicaepede/kan135/scheduler.py monitor
TimeoutStartSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clicaepede/kan135
MemoryMax=128M
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
