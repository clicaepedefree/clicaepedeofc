[Unit]
Description=KAN135 drain persisted safe preconnect retries
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/clicaepede/kan135/scheduler.py retry
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clicaepede/kan135
MemoryMax=128M
