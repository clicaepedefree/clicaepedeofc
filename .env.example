# ==============================================================================
# Clica Pedidos - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your values
#
# Required variables are marked with [REQUIRED]
# Optional variables have defaults shown in comments
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain Configuration
# ------------------------------------------------------------------------------
# These configure subdomain detection and CORS for multi-environment deployments.
# For local development, leave these unset to use defaults (localhost, admin).

# [OPTIONAL] Main application domain (default: localhost)
# Production example: clicapedidos.com.br
# Staging example: staging.clicapedidos.com.br
NEXT_PUBLIC_APP_DOMAIN=localhost

# [OPTIONAL] Admin subdomain prefix (default: admin)
# The admin panel will be accessible at {ADMIN_SUBDOMAIN}.{APP_DOMAIN}
# Example: admin.clicapedidos.com.br
NEXT_PUBLIC_ADMIN_SUBDOMAIN=admin

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection URL
POSTGRES_URL="postgresql://localhost:5432/clica_pede_local"

# [OPTIONAL] Drizzle debug mode (default: false)
DRIZZLE_DEBUG=false

# ------------------------------------------------------------------------------
# Authentication (Clerk)
# ------------------------------------------------------------------------------
# [REQUIRED] Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# [OPTIONAL] Separate HMAC secret for one-use store access invite links.
# Falls back to CLERK_SECRET_KEY when unset.
STORE_ACCESS_INVITE_SECRET=change-me-to-a-random-server-secret

# Clerk redirect URLs (adjust for your environment)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/admin-onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/admin-onboarding

# ------------------------------------------------------------------------------
# iFood Integration
# ------------------------------------------------------------------------------
# [REQUIRED for iFood features] Get from iFood Partner Portal
NEXT_PUBLIC_IFOOD_CLIENT_ID=xxx
IFOOD_CLIENT_SECRET=xxx
IFOOD_REDIRECT_URI=http://localhost:3000/api/integrations/ifood/callback

# [REQUIRED for iFood] AES-256 encryption key for OAuth token storage
# Generate with: openssl rand -hex 32
IFOOD_TOKEN_ENCRYPTION_KEY=xxx

# [OPTIONAL] iFood API base URL (default: https://merchant-api.ifood.com.br)
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br

# ------------------------------------------------------------------------------
# Fiscal/NFe Integration
# ------------------------------------------------------------------------------
# [REQUIRED for NFe features] Get from https://nfe.io
NFE_IO_API_KEY=xxx

# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx
# SUPABASE_JWT_SECRET=xxx

# [REQUIRED for Supabase Storage uploads] Public bucket used by the app: store-files

# ------------------------------------------------------------------------------
# Analytics (Optional)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# QZ Tray Printing (Optional - for silent printing)
# ------------------------------------------------------------------------------
# Enables silent printing without confirmation dialogs.
#
# Setup (one-time, by you):
# 1. Open QZ Tray > Advanced > Site Manager > Click +
# 2. Copy digital-certificate.txt contents to public/qz-tray/certificate.txt
# 3. Copy private-key.pem contents below (replace newlines with \n)
#
# Your users just need to:
# 1. Install QZ Tray
# 2. Import the certificate from your app (one-time)
#
# QZ_TRAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Progressive anti-bot protection for the public checkout (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=clicaepedeofc.vercel.app,clicaepedidos.com.br
