{
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 80,
    "trailingComma": "es5",
    "arrowParens": "avoid",
    "overrides": [
        {
            "files": [
                "*.json",
                "*.jsonc"
            ],
            "options": {
                "singleQuote": false,
                "trailingComma": "none"
            }
        }
    ]
}